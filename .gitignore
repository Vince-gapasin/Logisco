# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# diagrams and other scratch work, kept out of the repo on purpose
/scratch/

# Supabase CLI working files (version checks, linked project ref)
/supabase/.temp/

# Firebase config for push notifications. CI writes it from the
# GOOGLE_SERVICES_JSON secret; locally, download it from the Firebase console.
/android/app/google-services.json

# per-person Claude Code settings
.claude/settings.local.json
